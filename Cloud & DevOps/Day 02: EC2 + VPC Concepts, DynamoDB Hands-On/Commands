--- DYNAMODB ---
awslocal dynamodb create-table \
  --table-name <name> \
  --attribute-definitions AttributeName=id,AttributeType=S \
  --key-schema AttributeName=id,KeyType=HASH \
  --billing-mode PAY_PER_REQUEST

awslocal dynamodb list-tables
awslocal dynamodb put-item --table-name <name> --item '{"id": {"S": "item1"}, "message": {"S": "hello"}}'
awslocal dynamodb get-item --table-name <name> --key '{"id": {"S": "item1"}}'
awslocal dynamodb scan --table-name <name>
awslocal dynamodb delete-item --table-name <name> --key '{"id": {"S": "item1"}}'
awslocal dynamodb delete-table --table-name <name>

--- DYNAMODB DATA TYPE SHORTHAND (used in --item/--key JSON) ---
S  = String      N = Number      B = Binary
BOOL = Boolean   NULL = Null     SS/NS/BS = String/Number/Binary Set
M = Map          L = List

